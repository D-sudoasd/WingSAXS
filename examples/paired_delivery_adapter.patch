+def _bound_image_records(sample: Path, manifest: Mapping[str, Any]) -> list[Mapping[str, Any]]:
+    records = list(manifest.get("artifacts", []))
+    # This transient binding is never written into its own source manifest.
+    if not any(row.get("path") == "bundle_manifest.json" for row in records):
+        path = sample / "bundle_manifest.json"
+        records.append({"path": "bundle_manifest.json", "sha256": sha256_file(path),
+                        "size_bytes": path.stat().st_size})
+    return records
+
