+def _check_image_archive_links(data_zip: Path, image_zip: Path, sample_id: str) -> dict[str, Any]:
+    report = check_archive_pair(data_zip, image_zip, sample_id=sample_id)
+    if report["status"] != "ready":
+        raise DeliveryError(f"effective paired archive links failed: {report['issues'][:8]}")
+    return report
+
