+def _prepare_image_archive_members(data_zip: Path, sample: Path, manifest: Mapping[str, Any],
+                                   member_paths: list[Path] | None = None) -> list[Path]:
+    initial = member_paths if member_paths is not None else _image_archive_members(sample, manifest)
+    plan = plan_image_members(sample, [path.relative_to(sample).as_posix() for path in initial],
+                              _bound_image_records(sample, manifest), data_zip=data_zip)
+    if plan["status"] != "ready":
+        raise DeliveryError(f"registered IMAGE member plan failed: {plan['issues'][:8]}")
+    members = [sample / row["path"] for row in plan["members"]]
+    _check_sample_relative_links(data_zip, sample, members)
+    return members
+
